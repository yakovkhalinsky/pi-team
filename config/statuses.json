{
  "schemaVersion": 2,
  "lifecycle": {
    "stages": [
      { "id": "goal-receipt",          "name": "Goal receipt",            "owner": "team-lead",   "kind": "queued" },
      { "id": "routing-and-assignment","name": "Routing and assignment",  "owner": "dispatcher",  "kind": "queued" },
      { "id": "context-gathering",     "name": "Context gathering",       "owner": "researcher",  "kind": "active" },
      { "id": "action",                "name": "Action",                  "owner": "builder|runtime", "kind": "active" },
      { "id": "verification",          "name": "Verification",            "owner": "verifier",    "kind": "review" },
      { "id": "recording-and-archival","name": "Recording and archival",  "owner": "archivist",   "kind": "active" },
      { "id": "hand-off-or-closure",   "name": "Hand-off or closure",     "owner": "team-lead",   "kind": "terminal" }
    ],
    "transitions": [
      { "from": "goal-receipt",            "to": "routing-and-assignment" },
      { "from": "routing-and-assignment",  "to": "context-gathering" },
      { "from": "routing-and-assignment",  "to": "action" },
      { "from": "context-gathering",       "to": "action" },
      { "from": "action",                  "to": "verification" },
      { "from": "action",                  "to": "routing-and-assignment" },
      { "from": "verification",            "to": "recording-and-archival" },
      { "from": "verification",            "to": "action" },
      { "from": "verification",            "to": "routing-and-assignment" },
      { "from": "recording-and-archival",  "to": "hand-off-or-closure" }
    ],
    "initial": "goal-receipt",
    "terminal": ["hand-off-or-closure"]
  },
  "roles": {
    "team-lead":   { "stages": ["goal-receipt", "hand-off-or-closure"] },
    "dispatcher":  { "stages": ["routing-and-assignment"] },
    "researcher":  { "stages": ["context-gathering"] },
    "builder":     { "stages": ["action"] },
    "runtime":     { "stages": ["action"] },
    "verifier":    { "stages": ["verification"] },
    "archivist":   { "stages": ["recording-and-archival"] }
  },
  "anti-patterns": [
    "role-collapse",
    "missing-dispatcher",
    "verifiability-gap",
    "memory-blindness",
    "skipped-researcher",
    "runtime-without-rollback",
    "archivist-as-secretary"
  ]
}
